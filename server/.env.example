# Copiar a .env y ajustar. docker compose lo lee automáticamente.

# sim = nodos FSK simulados (demo sin radio) | usb = gateway ESP32-S3 + RFM69HCW por USB
MESH_CONNECTION=sim
# Solo para usb: puerto del gateway (vacío = autodetectar). Linux: /dev/ttyACM0 · Windows: COM5
MESH_USB_DEVICE=
MESH_USB_BAUD=115200

# Alerta de batería baja (% de carga)
LOW_BATTERY_PCT=20

# Mosaicos del mapa. Para operar sin internet, apuntar a un servidor de mosaicos local
# (ver README, sección "Mapa offline"). Vacío = OpenStreetMap en línea.
TILE_URL=

LOG_LEVEL=INFO
